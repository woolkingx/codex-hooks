{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "general.json",
  "title": "Bash General Definitions",
  "description": "Common types, file status flags, identifier rules, and utility types from general.h.",

  "definitions": {

    "FileStatusFlags": {
      "type": "object",
      "description": "FS_* flags for file status checking functions.",
      "properties": {
        "FS_EXISTS":         { "const": 1,  "description": "File exists" },
        "FS_EXECABLE":       { "const": 2,  "description": "File is executable" },
        "FS_EXEC_PREFERRED": { "const": 4,  "description": "Prefer executable" },
        "FS_EXEC_ONLY":      { "const": 8,  "description": "Executable only" },
        "FS_DIRECTORY":      { "const": 16, "description": "Is a directory" },
        "FS_NODIRS":         { "const": 32, "description": "Exclude directories" },
        "FS_READABLE":       { "const": 64, "description": "File is readable" }
      }
    },

    "IdentifierRules": {
      "type": "object",
      "description": "Rules for legal shell identifiers.",
      "properties": {
        "starterPattern": {
          "type": "string",
          "const": "[a-zA-Z_]",
          "description": "First character: alpha or underscore"
        },
        "bodyPattern": {
          "type": "string",
          "const": "[a-zA-Z0-9_]",
          "description": "Subsequent characters: alphanumeric or underscore"
        },
        "fullPattern": {
          "type": "string",
          "const": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Complete identifier regex"
        }
      }
    },

    "StringIntAlist": {
      "type": "object",
      "description": "STRING_INT_ALIST — maps string to integer. Used in tokenization.",
      "properties": {
        "word":  { "type": "string" },
        "token": { "type": "integer" }
      }
    },

    "WhitespaceChars": {
      "type": "object",
      "description": "Character classification helpers.",
      "properties": {
        "whitespace": {
          "const": [" ", "\t"],
          "description": "whitespace(c): space or tab"
        },
        "spctabnl": {
          "const": [" ", "\t", "\n"],
          "description": "spctabnl(c): space, tab, or newline. Used for IFS field splitting"
        }
      }
    }
  }
}
