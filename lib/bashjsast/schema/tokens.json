{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tokens.json",
  "title": "Bash Lexer Token Types",
  "description": "Token structure and type enum. Contract between lexer and parser.",

  "definitions": {

    "Token": {
      "type": "object",
      "description": "A single token produced by the lexer.",
      "required": ["type", "value"],
      "properties": {
        "type": {
          "$ref": "#/definitions/TokenType"
        },
        "value": {
          "type": "string",
          "description": "Raw text of the token."
        },
        "pos": {
          "$ref": "word.json#/definitions/Position"
        }
      },
      "additionalProperties": false
    },

    "TokenType": {
      "type": "string",
      "description": "All token types. Mapped from parse.y %token declarations and yylex() output.",
      "enum": [

        "WORD",
        "ASSIGNMENT_WORD",
        "NUMBER",
        "REDIR_WORD",
        "ARITH_CMD",
        "ARITH_FOR_EXPRS",
        "COND_CMD",

        "IF",
        "THEN",
        "ELSE",
        "ELIF",
        "FI",
        "CASE",
        "ESAC",
        "FOR",
        "SELECT",
        "WHILE",
        "UNTIL",
        "DO",
        "DONE",
        "IN",
        "FUNCTION",
        "COPROC",
        "BANG",
        "TIME",
        "TIMEOPT",
        "TIMEIGN",

        "COND_START",
        "COND_END",
        "COND_ERROR",

        "AND_AND",
        "OR_OR",
        "GREATER_GREATER",
        "LESS_LESS",
        "LESS_AND",
        "GREATER_AND",
        "SEMI_SEMI",
        "SEMI_AND",
        "SEMI_SEMI_AND",
        "LESS_LESS_MINUS",
        "LESS_LESS_LESS",
        "AND_GREATER",
        "AND_GREATER_GREATER",
        "LESS_GREATER",
        "GREATER_BAR",
        "BAR_AND",

        "PIPE",
        "AMP",
        "SEMI",
        "NEWLINE",
        "LPAREN",
        "RPAREN",
        "LBRACE",
        "RBRACE",
        "GREAT",
        "LESS",
        "MINUS",

        "COMMENT",
        "EOF"
      ]
    },

    "TokenCategory": {
      "type": "string",
      "description": "Logical grouping for token types. Not stored on tokens — used for parser dispatch.",
      "enum": [
        "word",
        "reserved",
        "operator",
        "redirection",
        "separator",
        "meta"
      ]
    },

    "TokenCategoryMap": {
      "type": "object",
      "description": "Which tokens belong to which category. Reference table.",
      "properties": {
        "word": {
          "const": ["WORD", "ASSIGNMENT_WORD", "NUMBER", "REDIR_WORD"]
        },
        "reserved": {
          "const": [
            "IF", "THEN", "ELSE", "ELIF", "FI",
            "CASE", "ESAC", "IN",
            "FOR", "SELECT", "WHILE", "UNTIL", "DO", "DONE",
            "FUNCTION", "COPROC",
            "BANG", "TIME", "TIMEOPT", "TIMEIGN"
          ]
        },
        "compound": {
          "description": "Tokens produced by sub-parsers, not yylex directly.",
          "const": ["ARITH_CMD", "ARITH_FOR_EXPRS", "COND_CMD"]
        },
        "conditional": {
          "const": ["COND_START", "COND_END", "COND_ERROR"]
        },
        "operator": {
          "const": ["AND_AND", "OR_OR", "PIPE", "BAR_AND"]
        },
        "redirection": {
          "const": [
            "GREAT", "LESS",
            "GREATER_GREATER", "LESS_LESS",
            "LESS_AND", "GREATER_AND",
            "LESS_LESS_MINUS", "LESS_LESS_LESS",
            "AND_GREATER", "AND_GREATER_GREATER",
            "LESS_GREATER", "GREATER_BAR"
          ]
        },
        "separator": {
          "const": [
            "SEMI", "SEMI_SEMI", "SEMI_AND", "SEMI_SEMI_AND",
            "AMP", "NEWLINE"
          ]
        },
        "grouping": {
          "const": ["LPAREN", "RPAREN", "LBRACE", "RBRACE"]
        },
        "meta": {
          "const": ["COMMENT", "EOF"]
        }
      }
    }
  }
}
