{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codex-hooks.policy.user",
  "description": "User requirement data for codex-hooks authoring. Runtime does not read this file directly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requirements"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/requirement"
      }
    }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "requirement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "enum": [
            "permission-request",
            "post-compact",
            "post-tool-use",
            "pre-compact",
            "pre-tool-use",
            "session-start",
            "stop",
            "subagent-start",
            "subagent-stop",
            "user-prompt-submit"
          ]
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
