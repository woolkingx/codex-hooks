{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codex-hooks.status",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "default": "" },
    "health": { "enum": ["ok", "error"], "default": "ok" },
    "source_log": { "type": ["string", "null"], "default": null },
    "total_runs": { "type": "integer", "minimum": 0, "default": 0 },
    "error_runs": { "type": "integer", "minimum": 0, "default": 0 },
    "rule_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "default": {}
    },
    "repeat_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "last_fired_at": { "type": "integer", "minimum": 0 }
              },
              "required": ["last_fired_at"]
            }
          },
          "default": {}
        }
      },
      "required": ["sessions"],
      "default": { "sessions": {} }
    },
    "hook_state": {
      "$ref": "#/definitions/hook_state",
      "default": {
        "version": "0.0.1",
        "projects": {}
      }
    },
    "last_event": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "trace_id":      { "type": "string" },
        "event_name":    { "type": "string" },
        "fired_rule_id": { "type": ["string", "null"], "default": null },
        "created_at":    { "type": "string" },
        "duration_ms":   { "type": "number", "minimum": 0 }
      },
      "required": ["trace_id", "event_name", "fired_rule_id", "created_at", "duration_ms"],
      "default": null
    },
    "recent": {
      "type": "array",
      "items": { "$ref": "#/definitions/recent_run" },
      "default": []
    },
    "trace": {
      "type": "array",
      "items": { "$ref": "#/definitions/recent_run" },
      "default": []
    }
  },
  "required": [
    "run_id",
    "health",
    "source_log",
    "total_runs",
    "error_runs",
    "rule_counts",
    "repeat_state",
    "hook_state",
    "last_event",
    "recent",
    "trace"
  ],
  "definitions": {
    "hook_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "projects": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/hook_state_project" },
          "default": {}
        }
      },
      "required": ["version", "projects"]
    },
    "hook_state_project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "updated_at": { "type": "integer", "minimum": 0 },
        "sessions": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/hook_state_session" },
          "default": {}
        }
      },
      "required": ["updated_at", "sessions"]
    },
    "hook_state_session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "updated_at": { "type": "integer", "minimum": 0 },
        "compact_mark": { "type": "integer", "minimum": 0 },
        "processed_compacts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "default": {}
        },
        "seen": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "default": {}
        }
      },
      "required": ["updated_at", "compact_mark", "processed_compacts", "seen"]
    },
    "recent_run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id":      { "type": "string" },
        "event_name":    { "type": "string" },
        "fired_rule_id": { "type": ["string", "null"], "default": null },
        "duration_ms":   { "type": "number", "minimum": 0 },
        "created_at":    { "type": "string" }
      },
      "required": ["trace_id", "event_name", "fired_rule_id", "duration_ms", "created_at"]
    }
  }
}
