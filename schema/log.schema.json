{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codex-hooks.log",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entries": { "type": "array", "items": { "$ref": "#/definitions/log_entry" }, "default": [] },
    "retention_days": { "type": "integer", "minimum": 1, "default": 7 },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "required": ["patterns"],
      "default": { "patterns": [] }
    }
  },
  "required": ["entries", "retention_days", "redaction"],
  "definitions": {
    "log_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id":      { "type": "string" },
        "event_id":      { "type": "string" },
        "event_name":    { "type": "string" },
        "fired_rule_id": { "type": ["string", "null"], "default": null },
        "duration_ms":   { "type": "number", "minimum": 0 },
        "created_at":    { "type": "string" },
        "input":         {},
        "output":        {},
        "error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "layer":    { "type": "string", "enum": ["sdu", "pci", "feature", "next-pdu", "executor", "load"] },
            "code":     { "type": "string" },
            "message":  { "type": "string" },
            "context":  { "type": "object" },
            "source":   { "type": "object" }
          },
          "required": ["layer", "code", "message"],
          "default": null
        }
      },
      "required": ["trace_id", "event_id", "event_name", "fired_rule_id", "duration_ms", "created_at", "input", "output", "error"]
    }
  }
}
